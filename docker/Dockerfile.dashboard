FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for WeasyPrint + geopandas
RUN apt-get update && apt-get install -y \
    libgeos-dev \
    libproj-dev \
    gdal-bin \
    libgdal-dev \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir -e ".[dashboard,pdf,geo]"

# Streamlit config
COPY .streamlit/ .streamlit/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/incrementality/dashboard/mmm/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
